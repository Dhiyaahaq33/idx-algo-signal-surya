TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token JWT Stockbit buat narik NVAL per broker (algo bandar_broksum).
# Ambilnya: login Stockbit di browser > buka halaman broker summary / bandar detector >
# DevTools (F12) > Network > klik request ke exodus.stockbit.com > Headers >
# Authorization: Bearer <TOKEN> > copy bagian setelah "Bearer ".
# Umurnya cuma ~24 jam, jadi refresh tiap hari. Login-nya di-CAPTCHA, gak bisa diotomatisin.
# Boleh dikosongin - kalau kosong, algo bandar_broksum jalan dari CSV di broksum/.
STOCKBIT_TOKEN=

# Opsional - kalau kosong, push ke Google Sheets di-skip otomatis
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=

# Opsional - notifikasi WhatsApp via Fonnte (md.fonnte.com), kalau kosong di-skip otomatis
FONNTE_TOKEN=
FONNTE_TARGET=
